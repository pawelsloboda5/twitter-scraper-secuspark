# Twitter/X Authentication Cookies
# Export these from your browser (DevTools > Application > Cookies > x.com)
#
# Required cookies:
#   auth_token  — Authentication session token (HttpOnly, won't appear in document.cookie)
#   ct0         — CSRF token
#   guest_id    — Guest identifier (needed for x-xp-forwarded-for anti-bot header)
#
# Format: JSON array of tough-cookie objects
TWITTER_COOKIES=[{"key":"auth_token","value":"YOUR_AUTH_TOKEN","domain":".x.com","path":"/","secure":true,"httpOnly":true},{"key":"ct0","value":"YOUR_CT0_TOKEN","domain":".x.com","path":"/","secure":true},{"key":"guest_id","value":"YOUR_GUEST_ID","domain":".x.com","path":"/","secure":true}]

# Optional: proxy URL for requests
# PROXY_URL=http://user:pass@host:port
